# Railway fournit DATABASE_URL automatiquement via le service PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/humanitdb"

JWT_SECRET="change_this_to_a_long_random_secret_in_production"
JWT_EXPIRES_IN="7d"
PORT=3001
NODE_ENV=production

# URL du frontend pour CORS (ex: https://humanit-backoffice.vercel.app)
# Plusieurs URLs séparées par des virgules
FRONTEND_URL=http://localhost:5173

# HelloAsso
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
HELLOASSO_ORG_SLUG=
HELLOASSO_WEBHOOK_SECRET=

# Remitly (optionnel)
REMITLY_API_KEY=

# ── Notifications automatiques (passage en RETARD) ────────────────────────

# Email — Gmail SMTP
# 1. Activez la validation en 2 étapes sur votre compte Google
# 2. Allez sur myaccount.google.com → Sécurité → Mots de passe des applications
# 3. Créez un mot de passe "Mail" → copiez les 16 caractères ici
SMTP_USER=ali.isback922@gmail.com
SMTP_PASS=

# WhatsApp — Green API (GRATUIT 2000 msg/mois, fonctionne avec n'importe quel numéro)
# Setup (5 min) :
#   1. Créez un compte sur https://green-api.com (gratuit)
#   2. Créez une instance → cliquez "Scan QR" → scannez avec WhatsApp
#   3. Copiez l'Instance ID et le Token API ci-dessous
GREENAPI_INSTANCE_ID=
GREENAPI_TOKEN=

# Override destinataire pour les tests (laissez vide en production)
# Si renseigné, TOUTES les notifs WhatsApp vont ici au lieu du vrai donateur
NOTIFY_TEST_EMAIL=ali.isback922@gmail.com
NOTIFY_TEST_PHONE=
